{
  "version": 2,
  "patient": {
    "schemaVersion": 2,
    "userId": "firebase-uid",
    "nombre": "string",
    "nombreNormalizado": "string",
    "nh": "string|null",
    "nhNormalizado": "string|null",
    "estadoClinico": "activo|alta|archivado",
    "ficha": "clinicalRecord",
    "ultimoAnalisisId": "string",
    "ultimaIncorporacionId": "string|null",
    "fechaCreacion": "timestamp",
    "ultimaActualizacion": "timestamp"
  },
  "extractedField": {
    "valor": "unknown|null",
    "valorExtraido": "unknown|null",
    "confianza": "alta|media|baja",
    "confianzaExtraccion": "alta|media|baja|null",
    "evidencia": "string|null",
    "procedenciaValor": "gemini|manual|no_encontrado",
    "revisadoManualmente": "boolean"
  },
  "clinicalRecord": {
    "identificacion": "object",
    "diagnostico": "object",
    "salud": "object",
    "escolarizacion": "object",
    "desarrollo_y_contexto": "object",
    "familia": "object",
    "apoyo_profesional": "object",
    "evaluaciones": "array",
    "objetivos": "object",
    "informacion_adicional": "array"
  },
  "analysis": {
    "path": "patients/{patientId}/analyses/{analysisId}",
    "schemaVersion": 2,
    "userId": "firebase-uid",
    "patientId": "string",
    "estado": "revisado|error",
    "documentoFuente": "fileMetadata",
    "extraccionOriginal": "clinicalRecord",
    "extraccionRevisada": "clinicalRecord",
    "revisionPrivacidad": {
      "confirmed": true,
      "confirmedAt": "ISO-8601",
      "checklistVersion": 1,
      "method": "pdf_local_scan|docx_local_text|null",
      "automaticReplacementTypes": "string[]|null",
      "localScan": {
        "status": "inspected|unreadable|error|unknown",
        "findingTypes": "string[]"
      }
    },
    "revisionHumana": "reviewMetadata",
    "comparacionFicha": {
      "camposPropuestos": "string[]",
      "camposIncorporados": "string[]"
    },
    "camposModificados": "string[]",
    "fechaCreacion": "timestamp"
  },
  "document": {
    "path": "patients/{patientId}/documents/{documentId}",
    "userId": "firebase-uid",
    "patientId": "string",
    "tipo": "piat_inicial|piat_revision|evaluacion|informe_clinico|informe_escolar|otro",
    "nombreOriginal": "string",
    "mimeType": "application/pdf|application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "tamano": "number",
    "fechaDocumento": "YYYY-MM-DD|null",
    "sha256": "string",
    "archivoConservado": false,
    "modoEntrada": "transient_pdf|anonymized_text",
    "estado": "procesando|analizado|error|archivado",
    "fechaCreacion": "timestamp",
    "ultimaActualizacion": "timestamp"
  },
  "revision": {
    "path": "patients/{patientId}/revisions/{revisionId}",
    "userId": "firebase-uid",
    "patientId": "string",
    "tipoEvento": "revision_manual|incorporacion_documento",
    "analysisId": "string|null",
    "camposModificados": "string[]",
    "cambios": "change[]",
    "fechaCreacion": "timestamp"
  },
  "report": {
    "path": "patients/{patientId}/reports/{reportId}",
    "userId": "firebase-uid",
    "patientId": "string",
    "tipo": "piat_revision",
    "estado": "borrador",
    "titulo": "string",
    "secciones": "reportSection[]",
    "version": "number",
    "confirmacionProfesional": {
      "objetivosAnteriores": "{texto, clasificacion: conseguido|en_proceso|descartado}[]",
      "actualizacionClinica": "object",
      "confirmadoPorProfesional": true
    },
    "fuente": "reportSourceMetadata",
    "privacidad": "reportPrivacyMetadata",
    "fechaCreacion": "timestamp",
    "ultimaActualizacion": "timestamp"
  },
  "states": {
    "patient": ["activo", "alta", "archivado"],
    "analysis": ["pendiente", "procesando", "revisado", "error"],
    "document": ["procesando", "analizado", "error", "archivado"]
  },
  "compatibility": {
    "legacyPatientStatusField": "estado",
    "legacyActiveValue": "activo",
    "legacyPendingAnalysisValue": "pendiente_analisis"
  }
}
