rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/patients/{patientId}/documents/{documentId}/{fileName} {
      function ownsPath() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validPdf() {
        return fileName == "original.pdf"
          && request.resource.size <= 8 * 1024 * 1024
          && request.resource.contentType == "application/pdf";
      }

      allow read: if ownsPath();
      allow create, update: if ownsPath() && validPdf();
      allow delete: if ownsPath();
    }
  }
}
