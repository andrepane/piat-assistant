rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPatient(patientId) {
      return signedIn()
        && get(/databases/$(database)/documents/patients/$(patientId)).data.userId
          == request.auth.uid;
    }

    function ownsPatientAfterWrite(patientId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/patients/$(patientId)).data.userId
          == request.auth.uid;
    }

    match /patients/{patientId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/patients/$(patientId))
          || resource.data.userId == request.auth.uid
        );

      allow list: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      match /analyses/{analysisId} {
        allow read: if ownsPatient(patientId);

        allow create: if ownsPatientAfterWrite(patientId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.patientId == patientId;

        allow update: if ownsPatient(patientId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.patientId == patientId;

        allow delete: if ownsPatient(patientId)
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
